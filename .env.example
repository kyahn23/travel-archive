# Travel Archive 환경 설정 파일
# 이 파일을 .env로 복사한 후 필요한 값을 수정하세요.
# .env 파일은 git에 포함되지 않으므로 각 개발자의 로컬 설정에 사용됩니다.

# =============================================================================
# PostgreSQL 설정
# =============================================================================

# PostgreSQL 외부 포트 (호스트 머신에서 접근할 포트)
# 로컬에 PostgreSQL이 이미 설치되어 있어 5432 포트가 점유된 경우 변경하세요.
POSTGRES_PORT=5432

# =============================================================================
# 백엔드 데이터베이스 연결 설정
# =============================================================================

# PostgreSQL JDBC URL
# 포트를 변경한 경우 POSTGRES_PORT와 일치해야 합니다.
DB_URL=jdbc:postgresql://localhost:5432/travel_archive

# 데이터베이스 사용자/비밀번호
DB_USERNAME=travel_archive
DB_PASSWORD=travel_archive

# =============================================================================
# 백엔드 서버 설정
# =============================================================================

# 서버 포트
SERVER_PORT=8080

# JWT 서명용 비밀키 (최소 32자, 운영 환경에서는 반드시 변경!)
# 예: JWT_SECRET=your-32-char-secret-key-here-change-me
JWT_SECRET=

# =============================================================================
# 프론트엔드 설정
# =============================================================================

# Next.js 개발 서버 포트
NEXT_DEV_PORT=3000

# API 프록시 대상 URL
# 로컬 개발: http://localhost:8080
# Next.js 서버가 요청을 전달할 backend origin (브라우저에는 노출되지 않음)
# 로컬 개발: http://localhost:8080
# Docker Compose: http://travel-archive-backend:8080
API_ORIGIN=http://localhost:8080

# Compose image/release 식별자. 운영 배포에서는 merge commit SHA를 사용합니다.
APP_VERSION=local

# =============================================================================
# 공유 인프라 설정 (docker-compose.infrastructure.yml)
# =============================================================================

# PostgreSQL 슈퍼유저 비밀번호 (다른 프로젝트에서도 공유)
# 최소 16자 이상의 강력한 비밀번호 사용
POSTGRES_ADMIN_PASSWORD=change-me-strong-password
